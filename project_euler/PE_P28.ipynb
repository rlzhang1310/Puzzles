   "source": [
    "def calc_ring(n):\n",
    "    if n == 1:\n",
    "        return 1\n",
    "    return n**2 + n**2 - (n - 1) + n**2 - (2*n - 2) + n**2 - (3*n - 3)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2c8d1a84",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "669171001\n"
     ]
    }
   ],
   "source": [
    "x = 0\n",
    "n = 1001\n",
    "for i in range(1, n+1, 2):\n",
    "    x += calc_ring(i)\n",
    "\n",
    "print(x)"
   ]
  }
