   "source": [
    "MOD = 10**10\n",
    "till = 1000\n",
    "def get_last_ten(n):\n",
    "    sol = 1\n",
    "    for i in range(n):\n",
    "        sol *= n\n",
    "        sol %= MOD\n",
    "\n",
    "    return sol\n",
    "\n",
    "total = 0\n",
    "for i in range(1, till + 1):\n",
    "    total += get_last_ten(i)\n",
    "    total %= MOD\n",
    "\n",
    "print(total)"
   ]
  }
 ],
